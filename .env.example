# Токен от @BotFather
BOT_TOKEN=123456789:AAAA...

# Твой и её Telegram ID через запятую (узнать: @userinfobot). Пусто = бот открыт для всех
ALLOWED_USERS=111111111,222222222

# --- Адрес Mini App (нужен HTTPS) — выбери ОДИН вариант ---
# 1) Запуск на своём компе через cloudflared (docker compose --profile tunnel up):
TUNNEL_METRICS_URL=http://tunnel:2000
# 2) Свой домен / VPS — тогда закомментируй строку выше и укажи:
# WEBAPP_URL=https://pocket.example.com

CURRENCY=₸
DEFAULT_TZ=Asia/Almaty

# Postgres вместо SQLite (например, бесплатный Neon/Supabase):
# DATABASE_URL=postgresql+asyncpg://user:pass@host/db
# Локальная разработка в браузере без Telegram (НЕ включать в проде!):
# DEV_USER_ID=1
